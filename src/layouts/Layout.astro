---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, any> | Array<Record<string, any>>;
}

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://svgcleankit.pages.dev';

const {
  title = "SVG Optimizer Online – Compress, Clean & Reduce SVG File Size | SVG Clean Kit",
  description = "Free SVG optimizer online to compress, clean, and minify SVG vector files. Reduce SVG file size by up to 80% without losing quality. 100% private, client-side SVG cleaner with JSX & Data URI export.",
  keywords = "svg optimizer, svg optimizer online, online svg optimizer, svg compressor, svg cleaner, reduce svg file size, svg minifier online, compress svg, clean svg, minify svg, svg file size reducer, svgo online, free svg optimizer, svg code cleaner, react svg jsx converter",
  canonicalUrl = new URL(Astro.url.pathname, siteUrl).href,
  ogImage = `${siteUrl}/og-image.jpg`,
  ogType = "website",
  structuredData,
} = Astro.props;

const defaultWebAppData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SVG Clean Kit",
  "alternateName": ["SVG Optimizer Online", "SVG Compressor", "SVG Cleaner", "SVG Minifier Online"],
  "url": siteUrl,
  "description": "Free, privacy-first online SVG optimizer, compressor, and cleaner. Reduce SVG file size, clean unnecessary editor metadata, and minify vector graphics directly in your browser with zero server uploads.",
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "DesignApplication",
  "operatingSystem": "All modern browsers (Chrome, Firefox, Safari, Edge)",
  "browserRequirements": "Requires modern web browser with WebAssembly / JavaScript support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Online SVG optimizer with real-time visual preview",
    "Lossless SVG compressor and path minifier",
    "Client-side SVG cleaner removing editor metadata and bloat",
    "Batch SVG file size reduction with multi-file ZIP export",
    "1-Click React JSX component export",
    "Data URI and CSS background-image generator",
    "100% private browser processing with zero remote uploads"
  ]
};

const defaultWebsiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "SVG Clean Kit",
  "alternateName": "SVG Optimizer Online",
  "url": siteUrl,
  "description": "Free, privacy-first online SVG optimizer, compressor, and cleaner tool to reduce SVG file size."
};

const schemasToRender = structuredData
  ? (Array.isArray(structuredData) ? [defaultWebAppData, defaultWebsiteData, ...structuredData] : [defaultWebAppData, defaultWebsiteData, structuredData])
  : [defaultWebAppData, defaultWebsiteData];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="SVG Clean Kit" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="application-name" content="SVG Clean Kit" />
    <meta name="apple-mobile-web-app-title" content="SVG Clean Kit" />

    <!-- Theme Colors -->
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="SVG Clean Kit" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SVG Clean Kit - Free Online SVG Optimizer & Compressor" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="SVG Clean Kit - Free Online SVG Optimizer & Compressor" />

    <!-- Fonts: Geist Sans & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data for SEO Rich Snippets -->
    {schemasToRender.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <!-- Theme initialization script (runs before render to prevent FOUC) -->
    <script is:inline>
      (function() {
        try {
          const theme = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (theme === 'dark' || (!theme && systemDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-body)] font-sans selection:bg-[var(--color-link-soft)] selection:text-[var(--color-ink)]">
    <slot />
  </body>
</html>
