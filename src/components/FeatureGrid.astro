---
---

<section id="features" class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    
    <!-- Section Eyebrow & Title -->
    <div class="max-w-2xl">
      <div class="flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-ink)]"></span>
        <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--color-mute)]">
          Built For Developers & Designers
        </span>
      </div>
      <h2 class="mt-2 font-sans text-2xl font-semibold tracking-[-1px] text-[var(--color-ink)] sm:text-3xl">
        Engineered for speed, privacy, and SVG optimization precision.
      </h2>
      <p class="mt-2 text-sm text-[var(--color-body)]">
        Traditional vector utilities upload your files to remote servers or enforce rigid black-box compression. SVGCleanKit is an <strong>online SVG optimizer</strong> that runs the complete SVGO engine inside your browser to clean, minify, and compress SVG vector graphics with pixel perfection.
      </p>
    </div>

    <!-- 6 Hairline Feature Cards Grid (DESIGN.md feature-card spec) -->
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      
      <!-- Card 1 -->
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 transition-all hover:border-neutral-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
        </div>
        <h3 class="mt-4 font-sans text-base font-semibold text-[var(--color-ink)]">
          100% Private Online SVG Optimizer
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[var(--color-body)]">
          Our <strong>online svg optimizer</strong> processes your vector graphics strictly in your web browser. No design file ever touches a remote server or third-party cloud.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 transition-all hover:border-neutral-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
          </svg>
        </div>
        <h3 class="mt-4 font-sans text-base font-semibold text-[var(--color-ink)]">
          Intelligent SVG Cleaner &amp; Sanitizer
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[var(--color-body)]">
          Use our automated <strong>svg cleaner</strong> to strip Adobe Illustrator, Inkscape, and Figma editor namespaces, comments, and empty tags to keep vector code clean.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 transition-all hover:border-neutral-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 15.75-2.489-2.489m0 0a3.375 3.375 0 1 0-4.773-4.773 3.375 3.375 0 0 0 4.774 4.774ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <h3 class="mt-4 font-sans text-base font-semibold text-[var(--color-ink)]">
          Visual Split-Screen SVG Compressor
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[var(--color-body)]">
          Inspect vector sharpness side-by-side. Our interactive <strong>svg compressor</strong> slider lets you verify original vs optimized output across multiple backgrounds.
        </p>
      </div>

      <!-- Card 4 -->
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 transition-all hover:border-neutral-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
          </svg>
        </div>
        <h3 class="mt-4 font-sans text-base font-semibold text-[var(--color-ink)]">
          SVG Minifier Online with JSX Export
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[var(--color-body)]">
          As a developer-first <strong>svg minifier online</strong>, SVGCleanKit converts SVG attributes into camelCase React JSX components and CSS Data URIs in one click.
        </p>
      </div>

      <!-- Card 5 -->
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 transition-all hover:border-neutral-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
          </svg>
        </div>
        <h3 class="mt-4 font-sans text-base font-semibold text-[var(--color-ink)]">
          Reduce SVG File Size with Precision Tuning
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[var(--color-body)]">
          Dial in coordinate precision from 1 to 5 decimal places. <strong>Reduce SVG file size</strong> by up to 80% while retaining crisp vector rendering at any display resolution.
        </p>
      </div>

      <!-- Card 6 -->
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 transition-all hover:border-neutral-300">
        <div class="flex h-10 w-10 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] border border-[var(--color-hairline)] text-[var(--color-ink)]">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <h3 class="mt-4 font-sans text-base font-semibold text-[var(--color-ink)]">
          Batch SVG Compressor &amp; ZIP Download
        </h3>
        <p class="mt-2 text-xs leading-relaxed text-[var(--color-body)]">
          Drag and drop up to 20 files at once. Compress entire icon packs simultaneously and download the minified vector assets as a unified ZIP archive.
        </p>
      </div>

    </div>

  </div>
</section>
