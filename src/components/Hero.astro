---
---

<section class="relative overflow-hidden border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] pt-16 pb-14 sm:pt-20 sm:pb-16">
  <!-- Mesh Gradient Bloom (Confined to hero as specified in DESIGN.md) -->
  <div class="pointer-events-none absolute inset-0 mesh-gradient-glow opacity-90"></div>

  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
    <!-- Technical Eyebrow in Geist Mono -->
    <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)]/80 px-3.5 py-1 text-xs backdrop-blur-xs">
      <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-link)]"></span>
      <span class="font-mono text-[11px] font-medium tracking-wide uppercase text-[var(--color-ink)]">
        100% Client-Side • Free Online SVG Optimizer & Cleaner • Powered by SVGO
      </span>
    </div>

    <!-- Display Heading in Geist Sans with tight negative letter spacing -->
    <h1 class="font-sans text-3xl font-semibold tracking-[-1.5px] text-[var(--color-ink)] sm:text-5xl sm:tracking-[-2.4px] sm:leading-[1.08]">
      Free Online SVG Optimizer &amp; SVG Compressor to Reduce File Size
    </h1>

    <!-- Lead Paragraph -->
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-[var(--color-body)] sm:text-base">
      Clean, compress, and minify your vector graphics in milliseconds. Our privacy-first <strong>online SVG optimizer</strong> and <strong>SVG cleaner</strong> strips metadata, editor namespaces, and redundant coordinate precision to <strong>reduce SVG file size by up to 80%</strong> — processed 100% locally in your browser with zero server uploads.
    </p>

    <!-- Marketing Action Buttons -->
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#app"
        class="inline-flex h-10 items-center justify-center rounded-full bg-[var(--color-primary)] px-6 text-sm font-medium text-[var(--color-on-primary)] shadow-xs transition-opacity hover:opacity-90 active:scale-98"
      >
        Optimize SVGs Free
      </a>
      <a
        href="#guide"
        class="inline-flex h-10 items-center justify-center rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-5 text-sm font-medium text-[var(--color-ink)] transition-colors hover:bg-[var(--color-hairline-soft)] active:scale-98"
      >
        How SVG Optimization Works
      </a>
    </div>

    <!-- Quick Features Spec Badges -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-[var(--color-hairline)]/70 pt-6 text-xs text-[var(--color-mute)]">
      <span class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        100% Private (Zero Uploads)
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        Lossless SVG Compressor
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        Interactive Split-View Slider
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        Export React JSX &amp; Data URI
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        Batch ZIP Minifier
      </span>
    </div>
  </div>
</section>
