  // Scopes all element IDs and url(#id)/href="#id" references to avoid collisions across multiple SVGs in the DOM
  function scopeSvgIds(svgCode: string, prefix: string): string {
    const idRegex = /id="([^"]+)"/g;
    const ids: string[] = [];
    let match;
    while ((match = idRegex.exec(svgCode)) !== null) {
      if (!ids.includes(match[1])) {
        ids.push(match[1]);
      }
    }

    let result = svgCode;
    ids.forEach((oldId) => {
      const newId = `${prefix}_${oldId}`;
      result = result.split(`id="${oldId}"`).join(`id="${newId}"`);
      result = result.split(`url(#${oldId})`).join(`url(#${newId})`);
      result = result.split(`url('#${oldId}')`).join(`url('#${newId}')`);
      result = result.split(`url("#${oldId}")`).join(`url("#${newId}")`);
      result = result.split(`href="#${oldId}"`).join(`href="#${newId}"`);
      result = result.split(`xlink:href="#${oldId}"`).join(`xlink:href="#${newId}"`);
    });

    return result;
  }

  // Normalizes an SVG for reliable display in preview containers with scoped IDs and guaranteed viewBox
  function prepareSvgPreview(svgCode: string, idPrefix: string): string {
    try {
      // Scope IDs first
      const scoped = scopeSvgIds(svgCode, idPrefix);

      const parser = new DOMParser();
      const doc = parser.parseFromString(scoped, 'image/svg+xml');
      const svg = doc.querySelector('svg');
      if (!svg) return scoped;

      let viewBox = svg.getAttribute('viewBox');
      const widthAttr = svg.getAttribute('width');
      const heightAttr = svg.getAttribute('height');

      // Synthesize viewBox if missing so vector graphic scales cleanly
      if (!viewBox && widthAttr && heightAttr) {
        const w = parseFloat(widthAttr.replace(/px$/, ''));
        const h = parseFloat(heightAttr.replace(/px$/, ''));
        if (!isNaN(w) && !isNaN(h) && w > 0 && h > 0) {
          svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
        }
      }

      // Configure SVG attributes and styles to scale responsively
      svg.setAttribute('width', '100%');
      svg.setAttribute('height', '100%');
      svg.style.width = '100%';
      svg.style.height = '100%';
      svg.style.maxWidth = '100%';
      svg.style.maxHeight = '100%';
      svg.style.display = 'block';
      svg.style.margin = 'auto';

      return new XMLSerializer().serializeToString(doc);
    } catch {
      return svgCode;
    }
  }

  // Extract dimensions for display
  function getSvgDimensions(svgCode: string): string {
    try {
      const parser = new DOMParser();
      const doc = parser.parseFromString(svgCode, 'image/svg+xml');
      const svg = doc.querySelector('svg');
      if (!svg) return '';
      const viewBox = svg.getAttribute('viewBox');
      if (viewBox) {
        const parts = viewBox.trim().split(/[\s,]+/);
        if (parts.length === 4) {
          const w = Math.round(parseFloat(parts[2]));
          const h = Math.round(parseFloat(parts[3]));
          if (!isNaN(w) && !isNaN(h)) return `${w}×${h}px`;
        }
      }
      const w = svg.getAttribute('width');
      const h = svg.getAttribute('height');
      if (w && h) {
        const parsedW = Math.round(parseFloat(w));
        const parsedH = Math.round(parseFloat(h));
        if (!isNaN(parsedW) && !isNaN(parsedH)) return `${parsedW}×${parsedH}px`;
      }
      return '';
    } catch {
      return '';
    }
  }

  // Switch Input Mode Tabs
  function setInputTab(tab: 'upload' | 'paste' | 'sample') {
    [uploadPanel, pastePanel, samplePanel].forEach(p => p.classList.add('hidden'));
    [modeUploadTab, modePasteTab, modeSampleTab].forEach(t => {
      t.className = 'flex items-center gap-1.5 rounded-[4px] px-3 py-1.5 text-xs font-medium text-[var(--color-body)] transition-all hover:text-[var(--color-ink)]';
    });

    const activeClasses = 'flex items-center gap-1.5 rounded-[4px] bg-[var(--color-primary)] px-3 py-1.5 text-xs font-medium text-[var(--color-on-primary)] transition-all';

    if (tab === 'upload') {
      uploadPanel.classList.remove('hidden');
      modeUploadTab.className = activeClasses;
    } else if (tab === 'paste') {
      pastePanel.classList.remove('hidden');
      modePasteTab.className = activeClasses;
      pasteInput.focus();
    } else {
      samplePanel.classList.remove('hidden');
      modeSampleTab.className = activeClasses;
    }
  }

  modeUploadTab.addEventListener('click', () => setInputTab('upload'));
  modePasteTab.addEventListener('click', () => setInputTab('paste'));
  modeSampleTab.addEventListener('click', () => setInputTab('sample'));

  // Switch View Mode (Side-by-Side vs Split Slider vs Code Diff)
  function setViewMode(mode: 'side' | 'split' | 'code') {
    currentViewMode = mode;
    canvasSideContainer.classList.add('hidden');
    canvasSideContainer.classList.remove('grid');
    canvasSplitContainer.classList.add('hidden');
    canvasSplitContainer.classList.remove('flex');
    canvasCodeContainer.classList.add('hidden');
    canvasCodeContainer.classList.remove('flex');

    [viewSideBtn, viewSplitBtn, viewCodeBtn].forEach(b => {
      b.className = 'rounded-[4px] px-2.5 py-1 text-xs font-medium text-[var(--color-body)] transition-all hover:text-[var(--color-ink)]';
    });

    const activeBtnClass = 'rounded-[4px] bg-[var(--color-canvas-elevated)] px-2.5 py-1 text-xs font-medium text-[var(--color-ink)] shadow-2xs transition-all';

    if (mode === 'side') {
      canvasSideContainer.classList.remove('hidden');
      canvasSideContainer.classList.add('grid');
      viewSideBtn.className = activeBtnClass;
    } else if (mode === 'split') {
      canvasSplitContainer.classList.remove('hidden');
      canvasSplitContainer.classList.add('flex');
      viewSplitBtn.className = activeBtnClass;
      setSplitPercent(currentSplitPct);
    } else {
      canvasCodeContainer.classList.remove('hidden');
      canvasCodeContainer.classList.add('flex');
      viewCodeBtn.className = activeBtnClass;
    }
  }

  viewSideBtn.addEventListener('click', () => setViewMode('side'));
  viewSplitBtn.addEventListener('click', () => setViewMode('split'));
  viewCodeBtn.addEventListener('click', () => setViewMode('code'));

  // Apply Zoom Level
  function updateZoom(newZoom: number) {
    currentZoom = Math.min(2.5, Math.max(0.5, newZoom));
    const label = `${Math.round(currentZoom * 100)}%`;
    zoomLevelLabel.textContent = label;

    const scaleStyle = `scale(${currentZoom})`;
    sideOrigStage.style.transform = scaleStyle;
    sideOptStage.style.transform = scaleStyle;
    splitStage.style.transform = scaleStyle;
  }

  zoomInBtn.addEventListener('click', () => updateZoom(currentZoom + 0.25));
  zoomOutBtn.addEventListener('click', () => updateZoom(currentZoom - 0.25));
  zoomResetBtn.addEventListener('click', () => updateZoom(1));

  // Canvas Background Toggle
  function setCanvasBg(bgClass: string) {
    [sideOrigPreviewBox, sideOptPreviewBox, canvasSplitContainer].forEach(c => {
      c.classList.remove('bg-checkerboard-light', 'bg-checkerboard-dark', 'bg-white', 'bg-neutral-900');
      c.classList.add(bgClass);
    });
    [bgCheckerLight, bgCheckerDark, bgWhite, bgBlack].forEach(b => b.classList.remove('ring-1', 'ring-[var(--color-ink)]'));
  }

  bgCheckerLight.addEventListener('click', () => { setCanvasBg('bg-checkerboard-light'); bgCheckerLight.classList.add('ring-1', 'ring-[var(--color-ink)]'); });
  bgCheckerDark.addEventListener('click', () => { setCanvasBg('bg-checkerboard-dark'); bgCheckerDark.classList.add('ring-1', 'ring-[var(--color-ink)]'); });
  bgWhite.addEventListener('click', () => { setCanvasBg('bg-white'); bgWhite.classList.add('ring-1', 'ring-[var(--color-ink)]'); });
  bgBlack.addEventListener('click', () => { setCanvasBg('bg-neutral-900'); bgBlack.classList.add('ring-1', 'ring-[var(--color-ink)]'); });

  // Update Split Position (Divider Handle)
  function setSplitPercent(pct: number) {
    currentSplitPct = Math.max(0, Math.min(100, pct));
    splitHandle.style.left = `${currentSplitPct}%`;
    splitOriginalLayer.style.clipPath = `polygon(0 0, ${currentSplitPct}% 0, ${currentSplitPct}% 100%, 0 100%)`;

    // Update preset pills
    [splitPos25, splitPos50, splitPos75].forEach(btn => {
      btn.className = 'px-1.5 py-0.5 rounded-full hover:bg-neutral-100 text-[var(--color-body)]';
    });
    if (Math.round(currentSplitPct) === 25) splitPos25.className = 'px-1.5 py-0.5 rounded-full bg-[var(--color-primary)] text-white font-semibold';
    if (Math.round(currentSplitPct) === 50) splitPos50.className = 'px-1.5 py-0.5 rounded-full bg-[var(--color-primary)] text-white font-semibold';
    if (Math.round(currentSplitPct) === 75) splitPos75.className = 'px-1.5 py-0.5 rounded-full bg-[var(--color-primary)] text-white font-semibold';
  }

  splitPos25.addEventListener('click', () => setSplitPercent(25));
  splitPos50.addEventListener('click', () => setSplitPercent(50));
  splitPos75.addEventListener('click', () => setSplitPercent(75));

  // Handle Dragging in Split View
  function handleSplitDrag(e: MouseEvent | TouchEvent) {
    if (!isDraggingSplit) return;
    const rect = splitStage.getBoundingClientRect();
    const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
    const x = clientX - rect.left;
    const pct = (x / rect.width) * 100;
    setSplitPercent(pct);
  }

  splitHandle.addEventListener('mousedown', (e) => {
    isDraggingSplit = true;
    e.preventDefault();
  });
  canvasSplitContainer.addEventListener('mousedown', (e) => {
    isDraggingSplit = true;
    handleSplitDrag(e);
  });
  window.addEventListener('mousemove', handleSplitDrag);
  window.addEventListener('mouseup', () => { isDraggingSplit = false; });

  splitHandle.addEventListener('touchstart', (e) => {
    isDraggingSplit = true;
  }, { passive: true });
  canvasSplitContainer.addEventListener('touchmove', handleSplitDrag, { passive: true });
  window.addEventListener('touchend', () => { isDraggingSplit = false; });

  // Optimize an individual queued item
  function optimizeItem(item: QueuedItem): QueuedItem {
    try {
      const res = optimizeSvgString(item.originalSvg, activeOptions);
      return { ...item, result: res, error: undefined };
    } catch (err: any) {
      return { ...item, error: err.message || 'Optimization failed' };
    }
  }

  // Re-run optimization on current active item
  function reoptimizeActive() {
    if (queue.length === 0) return;
    optimizingSpinner.classList.remove('hidden');
    optimizingSpinner.classList.add('inline-flex');

    setTimeout(() => {
      queue[activeIndex] = optimizeItem(queue[activeIndex]);
      optimizingSpinner.classList.add('hidden');
      optimizingSpinner.classList.remove('inline-flex');
      renderActiveItem();
      renderQueue();
    }, 20);
  }

  // Render active item in Studio
  function renderActiveItem() {
    if (queue.length === 0) {
      studioContainer.classList.add('hidden');
      return;
    }
    studioContainer.classList.remove('hidden');

    const item = queue[activeIndex];
    activeFilenameEl.textContent = item.name;

    if (item.error) {
      statBeforeSize.textContent = formatBytes(new Blob([item.originalSvg]).size);
      statAfterSize.textContent = 'Error';
      statSavingsBadge.textContent = item.error;
      statSavingsBadge.className = 'rounded-full bg-red-500/10 px-2 py-0.5 font-mono text-[11px] font-medium text-red-600 dark:text-red-400';
      return;
    }

    const res = item.result!;
    const origSizeFormatted = formatBytes(res.originalSize);
    const optSizeFormatted = formatBytes(res.optimizedSize);
    const savingsFormatted = `-${res.savingsPercent}%`;
    const dims = getSvgDimensions(res.originalSvg);

    // Global Stats
    statBeforeSize.textContent = origSizeFormatted;
    statAfterSize.textContent = optSizeFormatted;
    statSavingsBadge.textContent = `${savingsFormatted} (${formatBytes(res.savingsBytes)} saved)`;
    statSavingsBadge.className = 'rounded-full bg-emerald-500/10 px-2 py-0.5 font-mono text-[11px] font-medium text-emerald-600 dark:text-emerald-400';

    // Side-by-Side View Labels
    sideOrigSize.textContent = origSizeFormatted;
    sideOrigDims.textContent = dims;
    sideOptSize.textContent = optSizeFormatted;
    sideOptSavings.textContent = `${savingsFormatted} saved`;

    // Split View Labels
    labelOrigSize.textContent = origSizeFormatted;
    labelOptSize.textContent = `${optSizeFormatted} (${savingsFormatted})`;

    // Prepare normalized responsive SVG previews with UNIQUE SCOPED IDS to prevent paint server conflicts
    const sideOrig = prepareSvgPreview(res.originalSvg, 'side_orig');
    const sideOpt = prepareSvgPreview(res.optimizedSvg, 'side_opt');
    const splitOrig = prepareSvgPreview(res.originalSvg, 'split_orig');
    const splitOpt = prepareSvgPreview(res.optimizedSvg, 'split_opt');

    // Inject into Side-by-Side View
    sideOriginalSvg.innerHTML = sideOrig;
    sideOptimizedSvg.innerHTML = sideOpt;

    // Inject into Split View
    splitOriginalSvg.innerHTML = splitOrig;
    splitOptimizedSvg.innerHTML = splitOpt;

    // Inject into Code Diff View
    codeOrigText.value = res.originalSvg;
    codeOptText.value = res.optimizedSvg;
    codeOrigChars.textContent = res.originalSvg.length.toString();
    codeOptChars.textContent = res.optimizedSvg.length.toString();

    // Reset split to active percentage
    setSplitPercent(currentSplitPct);
  }

  // Quick copy on side-by-side pane
  sideQuickCopyBtn.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex].result) return;
    navigator.clipboard.writeText(queue[activeIndex].result!.optimizedSvg).then(() => {
      showToast('Clean SVG code copied!');
    });
  });

  // Render Queue Strip
  function renderQueue() {
    if (queue.length <= 1) {
      queueContainer.classList.add('hidden');
      return;
    }
    queueContainer.classList.remove('hidden');
    queueCount.textContent = queue.length.toString();

    let totalOriginal = 0;
    let totalOptimized = 0;

    queueList.innerHTML = '';
    queue.forEach((item, idx) => {
      if (item.result) {
        totalOriginal += item.result.originalSize;
        totalOptimized += item.result.optimizedSize;
      }

      const card = document.createElement('div');
      const isActive = idx === activeIndex;
      card.className = `flex shrink-0 items-center gap-2.5 rounded-[8px] border px-3 py-2 text-xs transition-all cursor-pointer ${
        isActive
          ? 'border-[var(--color-primary)] bg-[var(--color-canvas-elevated)] shadow-2xs ring-1 ring-[var(--color-primary)]'
          : 'border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)]/70 hover:bg-[var(--color-canvas-elevated)]'
      }`;

      const savingsText = item.result ? `-${item.result.savingsPercent}%` : 'Err';

      card.innerHTML = `
        <div class="flex flex-col">
          <span class="font-medium text-[var(--color-ink)] truncate max-w-[110px]">${item.name}</span>
          <span class="font-mono text-[10px] text-[var(--color-mute)]">${item.result ? formatBytes(item.result.optimizedSize) : 'Failed'}</span>
        </div>
        <span class="rounded-full bg-emerald-500/10 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">${savingsText}</span>
        <button type="button" class="remove-queue-btn text-neutral-400 hover:text-red-500 font-bold ml-1 text-sm leading-none" title="Remove">&times;</button>
      `;

      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('remove-queue-btn')) {
          e.stopPropagation();
          queue.splice(idx, 1);
          if (activeIndex >= queue.length) activeIndex = Math.max(0, queue.length - 1);
          renderQueue();
          renderActiveItem();
          return;
        }
        activeIndex = idx;
        renderQueue();
        renderActiveItem();
      });

      queueList.appendChild(card);
    });

    const totalSaved = Math.max(0, totalOriginal - totalOptimized);
    const totalPercent = totalOriginal > 0 ? Math.round((totalSaved / totalOriginal) * 1000) / 10 : 0;
    queueSavingsSummary.textContent = `Total Saved: ${formatBytes(totalSaved)} (-${totalPercent}%)`;
  }

  // Add files to queue
  function addFiles(files: FileList | File[]) {
    const promises: Promise<QueuedItem>[] = [];

    Array.from(files).forEach((file) => {
      if (!file.name.endsWith('.svg') && !file.name.endsWith('.svgz') && file.type !== 'image/svg+xml') return;
      const promise = new Promise<QueuedItem>((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const content = e.target?.result as string;
          resolve({
            id: Math.random().toString(36).substring(2, 9),
            name: file.name,
            originalSvg: content,
          });
        };
        reader.readAsText(file);
      });
      promises.push(promise);
    });

    Promise.all(promises).then((items) => {
      if (items.length === 0) return;
      const optimized = items.map((i) => optimizeItem(i));
      queue = [...queue, ...optimized];
      activeIndex = queue.length - items.length;
      renderQueue();
      renderActiveItem();
      showToast(`Loaded ${items.length} SVG${items.length > 1 ? 's' : ''}`);
    });
  }

  // File Input Change
  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files.length > 0) {
      addFiles(fileInput.files);
      fileInput.value = '';
    }
  });

  // Drag and drop events
  ['dragenter', 'dragover'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.add('border-[var(--color-link)]', 'bg-[var(--color-hairline-soft)]');
    });
  });

  ['dragleave', 'drop'].forEach(eventName => {
    dropZone.addEventListener(eventName, (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-[var(--color-link)]', 'bg-[var(--color-hairline-soft)]');
    });
  });

  dropZone.addEventListener('drop', (e: DragEvent) => {
    if (e.dataTransfer?.files && e.dataTransfer.files.length > 0) {
      addFiles(e.dataTransfer.files);
    }
  });

  // Paste SVG Code Handling
  applyPasteBtn.addEventListener('click', () => {
    const val = pasteInput.value.trim();
    if (!val || !val.includes('<svg')) {
      pasteError.classList.remove('hidden');
      return;
    }
    pasteError.classList.add('hidden');
    const newItem: QueuedItem = {
      id: Math.random().toString(36).substring(2, 9),
      name: `pasted-icon-${queue.length + 1}.svg`,
      originalSvg: val,
    };
    queue.push(optimizeItem(newItem));
    activeIndex = queue.length - 1;
    renderQueue();
    renderActiveItem();
    showToast('Pasted SVG optimized!');
  });

  clearPasteBtn.addEventListener('click', () => {
    pasteInput.value = '';
    pasteError.classList.add('hidden');
  });

  // Sample SVGs Buttons
  document.querySelectorAll('.sample-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const sampleId = btn.getAttribute('data-sample');
      const found = SAMPLE_SVGS.find((s) => s.id === sampleId);
      if (found) {
        const newItem: QueuedItem = {
          id: Math.random().toString(36).substring(2, 9),
          name: `${found.id}.svg`,
          originalSvg: found.svg,
        };
        queue.push(optimizeItem(newItem));
        activeIndex = queue.length - 1;
        renderQueue();
        renderActiveItem();
        showToast(`Loaded "${found.name}"`);
      }
    });
  });

  // Clear all button
  clearAllBtn.addEventListener('click', () => {
    queue = [];
    activeIndex = 0;
    renderQueue();
    renderActiveItem();
    showToast('Queue cleared');
  });

  // Preset buttons
  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const presetKey = btn.getAttribute('data-preset');
      if (presetKey && PRESETS[presetKey]) {
        activeOptions = { ...DEFAULT_OPTIONS, ...PRESETS[presetKey] };

        // Update UI buttons
        document.querySelectorAll('.preset-btn').forEach((b) => {
          b.className = 'preset-btn rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-2.5 py-1.5 text-center text-xs font-medium text-[var(--color-body)] transition-all hover:bg-[var(--color-hairline-soft)] hover:text-[var(--color-ink)]';
        });
        btn.className = 'preset-btn rounded-[6px] border border-[var(--color-ink)] bg-[var(--color-primary)] px-2.5 py-1.5 text-center text-xs font-medium text-[var(--color-on-primary)] shadow-2xs transition-all';

        // Update precision slider and checkboxes
        precisionSlider.value = activeOptions.floatPrecision.toString();
        precisionValue.textContent = `${activeOptions.floatPrecision} decimals`;

        (document.getElementById('opt-metadata') as HTMLInputElement).checked = activeOptions.removeMetadata;
        (document.getElementById('opt-editor') as HTMLInputElement).checked = activeOptions.removeEditorsNSData;
        (document.getElementById('opt-comments') as HTMLInputElement).checked = activeOptions.removeComments;
        (document.getElementById('opt-empty-tags') as HTMLInputElement).checked = activeOptions.removeEmptyContainers;
        (document.getElementById('opt-hidden') as HTMLInputElement).checked = activeOptions.removeHiddenElems;
        (document.getElementById('opt-cleanup-attrs') as HTMLInputElement).checked = activeOptions.cleanupAttrs;
        (document.getElementById('opt-colors') as HTMLInputElement).checked = activeOptions.convertColors;
        (document.getElementById('opt-styles') as HTMLInputElement).checked = activeOptions.convertStyleToAttrs;
        (document.getElementById('opt-namespaces') as HTMLInputElement).checked = activeOptions.removeUnusedNS;
        (document.getElementById('opt-ids') as HTMLInputElement).checked = activeOptions.cleanupIds;
        (document.getElementById('opt-multipass') as HTMLInputElement).checked = activeOptions.multipass;

        reoptimizeActive();
      }
    });
  });

  // Precision slider
  precisionSlider.addEventListener('input', () => {
    const val = parseInt(precisionSlider.value, 10);
    activeOptions.floatPrecision = val;
    precisionValue.textContent = `${val} decimals`;
    reoptimizeActive();
  });

  // Toggles change
  const toggleMap: Record<string, keyof OptimizationOptions> = {
    'opt-metadata': 'removeMetadata',
    'opt-editor': 'removeEditorsNSData',
    'opt-comments': 'removeComments',
    'opt-empty-tags': 'removeEmptyContainers',
    'opt-hidden': 'removeHiddenElems',
    'opt-cleanup-attrs': 'cleanupAttrs',
    'opt-colors': 'convertColors',
    'opt-styles': 'convertStyleToAttrs',
    'opt-namespaces': 'removeUnusedNS',
    'opt-ids': 'cleanupIds',
    'opt-multipass': 'multipass',
  };

  Object.entries(toggleMap).forEach(([id, optKey]) => {
    const el = document.getElementById(id) as HTMLInputElement;
    el?.addEventListener('change', () => {
      (activeOptions as any)[optKey] = el.checked;
      reoptimizeActive();
    });
  });

  document.getElementById('toggle-all-btn')?.addEventListener('click', () => {
    activeOptions = { ...DEFAULT_OPTIONS };
    precisionSlider.value = '3';
    precisionValue.textContent = '3 decimals';
    Object.entries(toggleMap).forEach(([id, optKey]) => {
      const el = document.getElementById(id) as HTMLInputElement;
      if (el) el.checked = Boolean(DEFAULT_OPTIONS[optKey]);
    });
    reoptimizeActive();
    showToast('Reset to default options');
  });

  // Download Single SVG
  downloadSingleBtn.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex].result) return;
    const item = queue[activeIndex];
    const blob = new Blob([item.result!.optimizedSvg], { type: 'image/svg+xml' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = item.name.replace(/\.svg$/, '') + '.min.svg';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast(`Downloaded ${a.download}`);
  });

  // Download All as ZIP
  downloadAllZipBtn.addEventListener('click', async () => {
    if (queue.length === 0) return;
    const filesToZip = queue
      .filter((q) => q.result)
      .map((q) => ({
        name: q.name.replace(/\.svg$/, '') + '.min.svg',
        content: q.result!.optimizedSvg,
      }));

    if (filesToZip.length === 0) return;
    downloadAllZipBtn.textContent = 'Compressing ZIP...';
    try {
      const zipBlob = await createZipBundle(filesToZip);
      const url = URL.createObjectURL(zipBlob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `svgcleankit-bundle-${Date.now()}.zip`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`ZIP downloaded (${filesToZip.length} files)`);
    } catch (err: any) {
      showToast('Error creating ZIP bundle');
    } finally {
      downloadAllZipBtn.innerHTML = `
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 16.5v-2.25m-9-6.75v9m0 0 3.75-3.75M12 18.75 8.25 15M12 3v9" />
        </svg>
        Save All as ZIP
      `;
    }
  });

  // Copy SVG Code
  copySvgBtn.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex].result) return;
    navigator.clipboard.writeText(queue[activeIndex].result!.optimizedSvg).then(() => {
      showToast('Optimized SVG code copied!');
    });
  });

  // Copy as JSX
  copyJsxBtn.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex].result) return;
    const jsx = convertToJsx(queue[activeIndex].result!.optimizedSvg);
    navigator.clipboard.writeText(jsx).then(() => {
      showToast('React JSX component copied!');
    });
  });

  // Copy as Data URI
  copyDataUriBtn.addEventListener('click', () => {
    if (queue.length === 0 || !queue[activeIndex].result) return;
    const dataUri = convertToDataUri(queue[activeIndex].result!.optimizedSvg);
    navigator.clipboard.writeText(dataUri).then(() => {
      showToast('Data URI copied!');
    });
  });

  // Initialize with the first sample SVG immediately
  window.addEventListener('DOMContentLoaded', () => {
    const firstSample = SAMPLE_SVGS[0];
    const initialItem: QueuedItem = {
      id: 'init-badge',
      name: `${firstSample.id}.svg`,
      originalSvg: firstSample.svg,
    };
    queue.push(optimizeItem(initialItem));
    activeIndex = 0;
    renderActiveItem();
  });
</script>
