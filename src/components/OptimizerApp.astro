---
---

<section id="app" class="relative scroll-mt-20 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] py-10 sm:py-14">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    
    <!-- Top Section Header -->
    <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>
          <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--color-mute)]">
            Interactive Workspace
          </span>
        </div>
        <h2 class="mt-1 font-sans text-2xl font-semibold tracking-[-0.8px] text-[var(--color-ink)] sm:text-3xl">
          Clean & Optimize Your SVGs
        </h2>
      </div>

      <!-- Input Mode Switcher (Upload vs Paste vs Samples) -->
      <div class="inline-flex w-full sm:w-auto justify-center rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-1 shadow-2xs">
        <button
          id="mode-upload-tab"
          type="button"
          class="flex items-center justify-center gap-1.5 rounded-[4px] bg-[var(--color-primary)] px-3 py-1.5 text-xs font-medium text-[var(--color-on-primary)] transition-all flex-1 sm:flex-initial"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 16.5v-2.25m-18 0V7.5A2.25 2.25 0 0 1 5.25 5.25h13.5A2.25 2.25 0 0 1 21 7.5v9m-9-12v12m0-12 3.75 3.75M12 3.75 8.25 7.5" />
          </svg>
          <span class="truncate">Upload</span>
        </button>
        <button
          id="mode-paste-tab"
          type="button"
          class="flex items-center justify-center gap-1.5 rounded-[4px] px-3 py-1.5 text-xs font-medium text-[var(--color-body)] transition-all hover:text-[var(--color-ink)] flex-1 sm:flex-initial"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
          </svg>
          <span class="truncate">Paste Code</span>
        </button>
        <button
          id="mode-sample-tab"
          type="button"
          class="flex items-center justify-center gap-1.5 rounded-[4px] px-3 py-1.5 text-xs font-medium text-[var(--color-body)] transition-all hover:text-[var(--color-ink)] flex-1 sm:flex-initial"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
          </svg>
          <span class="truncate">Samples</span>
        </button>
      </div>
    </div>

    <!-- PANEL 1: Upload Dropzone Panel -->
    <div id="upload-panel" class="mb-6 block">
      <div
        id="drop-zone"
        class="group relative flex cursor-pointer flex-col items-center justify-center rounded-[12px] border-2 border-dashed border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-6 sm:p-8 text-center transition-all hover:border-[var(--color-link)] hover:bg-[var(--color-canvas)]"
      >
        <input
          id="file-input"
          type="file"
          accept=".svg,.svgz,image/svg+xml"
          multiple
          class="absolute inset-0 cursor-pointer opacity-0"
        />
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-hairline-soft)] text-[var(--color-ink)] transition-transform group-hover:scale-105">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z" />
          </svg>
        </div>
        <p class="mt-3 text-sm font-semibold text-[var(--color-ink)]">
          Drag & drop your SVG files here, or <span class="text-[var(--color-link)] underline underline-offset-2">browse files</span>
        </p>
        <p class="mt-1 text-xs text-[var(--color-mute)]">
          Supports multiple SVGs up to 50MB. Processing is 100% in-browser.
        </p>
      </div>
    </div>

    <!-- PANEL 2: Paste SVG Code Panel (Hidden initially) -->
    <div id="paste-panel" class="mb-6 hidden">
      <div class="rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-4">
        <label for="paste-input" class="mb-2 block font-mono text-xs font-medium text-[var(--color-body)]">
          Paste Raw SVG Markup (<code class="text-[var(--color-ink)]">&lt;svg ...&gt;...&lt;/svg&gt;</code>)
        </label>
        <textarea
          id="paste-input"
          rows="6"
          placeholder='<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">...</svg>'
          class="w-full resize-y rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-3 font-mono text-xs text-[var(--color-ink)] outline-hidden transition-all focus:border-[var(--color-link)] focus:bg-[var(--color-canvas-elevated)]"
        ></textarea>
        <div class="mt-3 flex items-center justify-between">
          <span id="paste-error" class="hidden text-xs text-[var(--color-error)]">Invalid SVG string. Please check the code.</span>
          <div class="ml-auto flex gap-2">
            <button
              id="clear-paste-btn"
              type="button"
              class="rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-3 py-1.5 text-xs font-medium text-[var(--color-body)] hover:bg-[var(--color-hairline-soft)] hover:text-[var(--color-ink)]"
            >
              Clear
            </button>
            <button
              id="apply-paste-btn"
              type="button"
              class="rounded-[6px] bg-[var(--color-primary)] px-4 py-1.5 text-xs font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90"
            >
              Optimize Pasted Code
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- PANEL 3: Sample SVGs Panel (Hidden initially) -->
    <div id="sample-panel" class="mb-6 hidden">
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        <button
          type="button"
          data-sample="figma-badge"
          class="sample-btn group flex flex-col items-start rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-4 text-left transition-all hover:border-[var(--color-link)] hover:shadow-2xs"
        >
          <div class="flex w-full items-center justify-between">
            <span class="font-sans text-xs font-semibold text-[var(--color-ink)]">Figma Export Badge</span>
            <span class="rounded-full bg-purple-500/10 px-2 py-0.5 font-mono text-[10px] font-medium text-purple-600 dark:text-purple-400">~60% Bloat</span>
          </div>
          <p class="mt-1 text-[11px] leading-relaxed text-[var(--color-body)]">
            Contains empty groups, Illustrator metadata, unneeded xmlns, and long floats.
          </p>
          <span class="mt-3 text-[11px] font-medium text-[var(--color-link)] group-hover:underline">Load Sample &rarr;</span>
        </button>

        <button
          type="button"
          data-sample="analytics-chart"
          class="sample-btn group flex flex-col items-start rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-4 text-left transition-all hover:border-[var(--color-link)] hover:shadow-2xs"
        >
          <div class="flex w-full items-center justify-between">
            <span class="font-sans text-xs font-semibold text-[var(--color-ink)]">Analytics Chart</span>
            <span class="rounded-full bg-blue-500/10 px-2 py-0.5 font-mono text-[10px] font-medium text-blue-600 dark:text-blue-400">Excess Decimals</span>
          </div>
          <p class="mt-1 text-[11px] leading-relaxed text-[var(--color-body)]">
            Heavy gradient and line chart with redundant 6-digit float precision.
          </p>
          <span class="mt-3 text-[11px] font-medium text-[var(--color-link)] group-hover:underline">Load Sample &rarr;</span>
        </button>

        <button
          type="button"
          data-sample="clean-feather-icon"
          class="sample-btn group flex flex-col items-start rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-4 text-left transition-all hover:border-[var(--color-link)] hover:shadow-2xs"
        >
          <div class="flex w-full items-center justify-between">
            <span class="font-sans text-xs font-semibold text-[var(--color-ink)]">Lucide / Feather Icon</span>
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-medium text-emerald-600 dark:text-emerald-400">Icon Clean</span>
          </div>
          <p class="mt-1 text-[11px] leading-relaxed text-[var(--color-body)]">
            Minimalist vector icon. See precision rounding and xmlns cleanup.
          </p>
          <span class="mt-3 text-[11px] font-medium text-[var(--color-link)] group-hover:underline">Load Sample &rarr;</span>
        </button>
      </div>
    </div>

    <!-- BATCH QUEUE CAROUSEL / FILE STRIP -->
    <div id="queue-container" class="mb-6 hidden">
      <div class="flex items-center justify-between border-b border-[var(--color-hairline)] pb-2.5">
        <div class="flex items-center gap-2">
          <span class="font-sans text-xs font-semibold text-[var(--color-ink)]">
            Batch Queue (<span id="queue-count">0</span>)
          </span>
          <span id="queue-savings-summary" class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
            Total Saved: 0 KB (-0%)
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="clear-all-btn"
            type="button"
            class="rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-2.5 py-1 text-xs font-medium text-[var(--color-body)] hover:bg-[var(--color-hairline-soft)] hover:text-[var(--color-ink)]"
          >
            Clear All
          </button>
          <button
            id="download-all-zip-btn"
            type="button"
            class="flex items-center gap-1.5 rounded-[6px] bg-[var(--color-primary)] px-3 py-1 text-xs font-medium text-[var(--color-on-primary)] transition-opacity hover:opacity-90"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 16.5v-2.25m-9-6.75v9m0 0 3.75-3.75M12 18.75 8.25 15M12 3v9" />
            </svg>
            Save All as ZIP
          </button>
        </div>
      </div>

      <!-- File item bubbles/cards list -->
      <div id="queue-list" class="mt-3 flex gap-2.5 overflow-x-auto pb-2 scrollbar-thin">
        <!-- Rendered dynamically by script -->
      </div>
    </div>

    <!-- MAIN INTERACTIVE STUDIO (ACTIVE FILE VIEW) -->
    <div id="studio-container" class="rounded-[16px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] shadow-xs">
      
      <!-- Studio Header Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--color-hairline)] px-4 py-3 sm:px-6">
        <div class="flex items-center gap-3">
          <div class="flex h-8 w-8 items-center justify-center rounded-[6px] bg-[var(--color-canvas)] text-[var(--color-ink)] border border-[var(--color-hairline)]">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 id="active-filename" class="font-sans text-sm font-semibold text-[var(--color-ink)] truncate max-w-[200px] sm:max-w-xs">
                illustration.svg
              </h3>
              <span id="optimizing-spinner" class="hidden items-center gap-1 font-mono text-[10px] text-[var(--color-mute)]">
                <svg class="h-3 w-3 animate-spin text-[var(--color-link)]" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Optimizing...
              </span>
            </div>
            <div class="flex items-center gap-2 text-xs text-[var(--color-mute)]">
              <span>Before: <strong id="stat-before-size" class="text-[var(--color-body)]">0 KB</strong></span>
              <span>&rarr;</span>
              <span>After: <strong id="stat-after-size" class="text-[var(--color-ink)]">0 KB</strong></span>
              <span id="stat-savings-badge" class="rounded-full bg-emerald-500/10 px-2 py-0.5 font-mono text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
                -0% (0 KB saved)
              </span>
            </div>
          </div>
        </div>

        <!-- View Mode Toolbar -->
        <div class="flex flex-wrap items-center gap-2">
          
          <!-- Zoom Controls -->
          <div class="inline-flex items-center rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-0.5">
            <button
              id="zoom-out-btn"
              type="button"
              class="px-2 py-1 text-xs font-mono font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] rounded-[4px] transition-all"
              title="Zoom Out"
            >
              -
            </button>
            <button
              id="zoom-reset-btn"
              type="button"
              class="px-2 py-1 text-[11px] font-mono font-medium text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] rounded-[4px] transition-all"
              title="Reset Zoom / Fit"
            >
              <span id="zoom-level-label">100%</span>
            </button>
            <button
              id="zoom-in-btn"
              type="button"
              class="px-2 py-1 text-xs font-mono font-medium text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline-soft)] rounded-[4px] transition-all"
              title="Zoom In"
            >
              +
            </button>
          </div>

          <!-- View switcher -->
          <div class="inline-flex rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-0.5">
            <button
              id="view-side-btn"
              type="button"
              class="rounded-[4px] bg-[var(--color-canvas-elevated)] px-2.5 py-1 text-xs font-medium text-[var(--color-ink)] shadow-2xs transition-all"
              title="Side-by-Side Dual View"
            >
              Side-by-Side
            </button>
            <button
              id="view-split-btn"
              type="button"
              class="rounded-[4px] px-2.5 py-1 text-xs font-medium text-[var(--color-body)] transition-all hover:text-[var(--color-ink)]"
              title="Split Comparison Slider"
            >
              Split Slider
            </button>
            <button
              id="view-code-btn"
              type="button"
              class="rounded-[4px] px-2.5 py-1 text-xs font-medium text-[var(--color-body)] transition-all hover:text-[var(--color-ink)]"
              title="SVG Code Diff"
            >
              Code Diff
            </button>
          </div>

          <!-- Canvas Backdrop Picker -->
          <div class="inline-flex items-center gap-1 rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-1.5 py-1">
            <span class="text-[10px] font-mono text-[var(--color-mute)] mr-0.5">BG:</span>
            <button id="bg-checker-light" type="button" class="h-4 w-4 rounded-xs border border-neutral-300 bg-checkerboard-light ring-1 ring-[var(--color-ink)]" title="Light Checkerboard"></button>
            <button id="bg-checker-dark" type="button" class="h-4 w-4 rounded-xs border border-neutral-700 bg-checkerboard-dark" title="Dark Checkerboard"></button>
            <button id="bg-white" type="button" class="h-4 w-4 rounded-xs border border-neutral-200 bg-white" title="Pure White"></button>
            <button id="bg-black" type="button" class="h-4 w-4 rounded-xs border border-neutral-800 bg-neutral-900" title="Dark Canvas"></button>
          </div>
        </div>
      </div>

      <!-- Studio Body (Main Canvas + Settings Sidebar Grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[var(--color-hairline)]">
        
        <!-- Left / Center: Interactive SVG Visual Canvas or Code View (8 cols) -->
        <div class="lg:col-span-8 flex flex-col min-w-0">
          
          <!-- VISUAL MODE 1: Side-by-Side View (Default view) -->
          <div id="canvas-side-container" class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[var(--color-hairline)] min-h-[380px] sm:min-h-[460px] w-full">
            
            <!-- Left Card: Before (Original) -->
            <div class="flex flex-col h-full min-w-0 bg-[var(--color-canvas-elevated)]">
              <div class="flex items-center justify-between border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] px-3.5 py-2 text-xs">
                <div class="flex items-center gap-1.5">
                  <span class="rounded-[4px] bg-[var(--color-hairline-soft)] px-1.5 py-0.5 font-mono text-[10px] font-semibold text-[var(--color-ink)]">BEFORE</span>
                  <span class="font-medium text-[var(--color-ink)]">Original</span>
                </div>
                <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--color-mute)]">
                  <span id="side-orig-dims" class="hidden sm:inline"></span>
                  <strong id="side-orig-size" class="text-[var(--color-body)]">0 KB</strong>
                </div>
              </div>
              <div id="side-orig-preview-box" class="relative flex-1 flex items-center justify-center p-6 bg-checkerboard-light overflow-hidden min-h-[320px]">
                <div id="side-orig-stage" class="svg-preview-stage w-full h-full max-w-[85%] max-h-[85%] flex items-center justify-center transition-transform duration-150">
                  <div id="side-original-svg" class="w-full h-full flex items-center justify-center"></div>
                </div>
              </div>
            </div>

            <!-- Right Card: After (Optimized) -->
            <div class="flex flex-col h-full min-w-0 bg-[var(--color-canvas-elevated)]">
              <div class="flex items-center justify-between border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] px-3.5 py-2 text-xs">
                <div class="flex items-center gap-1.5">
                  <span class="rounded-[4px] bg-emerald-500/15 px-1.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-600 dark:text-emerald-400">AFTER</span>
                  <span class="font-medium text-emerald-600 dark:text-emerald-400">Cleaned & Minified</span>
                </div>
                <div class="flex items-center gap-2 font-mono text-[11px]">
                  <strong id="side-opt-size" class="text-[var(--color-ink)]">0 KB</strong>
                  <span id="side-opt-savings" class="rounded-full bg-emerald-500/10 px-2 py-0.5 font-semibold text-emerald-600 dark:text-emerald-400">-0%</span>
                </div>
              </div>
              <div id="side-opt-preview-box" class="relative flex-1 flex items-center justify-center p-6 bg-checkerboard-light overflow-hidden min-h-[320px]">
                <div id="side-opt-stage" class="svg-preview-stage w-full h-full max-w-[85%] max-h-[85%] flex items-center justify-center transition-transform duration-150">
                  <div id="side-optimized-svg" class="w-full h-full flex items-center justify-center"></div>
                </div>
                <button
                  id="side-quick-copy-btn"
                  type="button"
                  class="absolute bottom-3 right-3 rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)]/95 px-2.5 py-1 text-[11px] font-mono font-medium text-[var(--color-ink)] shadow-2xs hover:bg-[var(--color-hairline-soft)] transition-all backdrop-blur-xs"
                  title="Copy Clean SVG Markup"
                >
                  Copy Clean SVG
                </button>
              </div>
            </div>

          </div>

          <!-- VISUAL MODE 2: Split Slider View (Fixed & enhanced) -->
          <div id="canvas-split-container" class="hidden relative h-[380px] sm:h-[460px] w-full select-none items-center justify-center overflow-hidden bg-checkerboard-light p-4">
            
            <!-- Quick position presets on top bar inside split view -->
