---
import { faqs } from '../lib/faqs';
---

<section id="faq" class="border-b border-[var(--color-hairline)] bg-[var(--color-canvas)] py-16 sm:py-20">
  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    
    <div class="text-center">
      <div class="inline-flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-ink)]"></span>
        <span class="font-mono text-xs font-medium uppercase tracking-wider text-[var(--color-mute)]">
          Frequently Asked Questions
        </span>
      </div>
      <h2 class="mt-2 font-sans text-2xl font-semibold tracking-[-1px] text-[var(--color-ink)] sm:text-3xl">
        Frequently Asked Questions About SVG Optimization
      </h2>
      <p class="mx-auto mt-2 max-w-xl text-xs text-[var(--color-body)]">
        Common questions about how our online SVG optimizer, SVG cleaner, and SVG compressor reduce file size with zero quality loss.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="mt-10 space-y-3">
      {faqs.map((faq, i) => (
        <details class="group rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] p-4 transition-all open:shadow-2xs">
          <summary class="flex cursor-pointer items-center justify-between font-sans text-sm font-semibold text-[var(--color-ink)] select-none list-none">
            <span>{faq.q}</span>
            <span class="ml-4 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-hairline-soft)] text-[var(--color-ink)] transition-transform group-open:rotate-180">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-xs leading-relaxed text-[var(--color-body)] border-t border-[var(--color-hairline)] pt-3">
            {faq.a}
          </p>
        </details>
      ))}
    </div>

  </div>
</section>
