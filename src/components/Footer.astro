---
---

<footer class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas)] py-12 text-xs text-[var(--color-body)] transition-colors">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-center">
      
      <!-- Brand & Note -->
      <div class="max-w-sm space-y-2">
        <div class="flex items-center gap-2">
          <div class="flex h-6 w-6 items-center justify-center rounded-[4px] bg-[var(--color-ink)] text-[var(--color-canvas)]">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z" />
            </svg>
          </div>
          <span class="font-sans text-sm font-semibold tracking-tight text-[var(--color-ink)]">
            SVG Clean Kit
          </span>
        </div>
        <p class="text-[11px] leading-relaxed text-[var(--color-mute)]">
          Free, privacy-first SVG cleaning and optimization tool. All processing happens locally in your browser. Your SVG files never leave your device.
        </p>
      </div>

      <!-- Quick Nav Links & Legal Pages -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 text-[11px] font-medium text-[var(--color-body)]">
        <div class="flex flex-wrap items-center gap-4">
          <a href="/#app" class="hover:text-[var(--color-ink)] transition-colors">Optimizer</a>
          <a href="/#features" class="hover:text-[var(--color-ink)] transition-colors">Features</a>
          <a href="/#guide" class="hover:text-[var(--color-ink)] transition-colors">Guide</a>
          <a href="/about" class="hover:text-[var(--color-ink)] transition-colors">About Us</a>
          <a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Contact</a>
        </div>
        <span class="hidden sm:inline text-[var(--color-hairline)]">|</span>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/privacy" class="hover:text-[var(--color-ink)] transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-[var(--color-ink)] transition-colors">Terms of Service</a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-[var(--color-hairline)] pt-6 sm:flex-row">
      <p class="font-mono text-[11px] text-[var(--color-mute)]">
        &copy; {new Date().getFullYear()} SVG Clean Kit. Open, free, & 100% private.
      </p>
      <div class="flex items-center gap-4 text-[11px] text-[var(--color-mute)] font-mono">
        <span>Zero Telemetry • Zero Server Storage</span>
      </div>
    </div>
  </div>
</footer>
