---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="500 - Application Error | SVG Clean Kit"
  description="An unexpected error occurred while rendering the page."
>
  <Header />

  <main class="min-h-[calc(100vh-14rem)] flex items-center justify-center py-16 sm:py-24 bg-[var(--color-canvas)]">
    <div class="mx-auto max-w-lg px-4 sm:px-6 text-center">
      
      <!-- Graphic / Badge -->
      <div class="inline-flex items-center gap-2 rounded-full border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-3 py-1 text-xs font-mono text-[var(--color-mute)] mb-6">
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
        HTTP 500 • Application Error
      </div>

      <!-- Icon Graphic -->
      <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-[12px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] shadow-xs">
        <svg class="h-8 w-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
        </svg>
      </div>

      <!-- Main Heading -->
      <h1 class="font-sans text-4xl font-semibold tracking-[-2px] text-[var(--color-ink)] sm:text-5xl">
        Something Went Wrong
      </h1>

      <p class="mt-4 text-sm leading-relaxed text-[var(--color-body)]">
        An unexpected error occurred. Because SVG Clean Kit runs entirely within your browser, this is typically due to a temporary memory limit or an invalid SVG syntax string.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <button
          onclick="window.location.reload()"
          class="inline-flex h-9 w-full sm:w-auto items-center justify-center rounded-[6px] bg-[var(--color-ink)] px-5 text-xs font-semibold text-[var(--color-canvas)] transition-all hover:opacity-90 active:scale-98"
        >
          Reload Page
        </button>
        <a
          href="/"
          class="inline-flex h-9 w-full sm:w-auto items-center justify-center rounded-[6px] border border-[var(--color-hairline)] bg-[var(--color-canvas-elevated)] px-5 text-xs font-medium text-[var(--color-ink)] transition-colors hover:bg-[var(--color-hairline-soft)]"
        >
          Return to Optimizer
        </a>
      </div>

      <!-- Quick Helpful Links -->
      <div class="mt-12 border-t border-[var(--color-hairline)] pt-6">
        <p class="font-mono text-xs uppercase tracking-wider text-[var(--color-mute)] mb-3">
          Need Assistance?
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-xs font-medium text-[var(--color-body)]">
          <a href="/contact" class="hover:text-[var(--color-ink)] transition-colors">Report an Issue</a>
          <a href="/about" class="hover:text-[var(--color-ink)] transition-colors">About Us</a>
          <a href="/privacy" class="hover:text-[var(--color-ink)] transition-colors">Privacy Policy</a>
          <a href="/terms" class="hover:text-[var(--color-ink)] transition-colors">Terms of Service</a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
